import cv2

cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()

    if not ret:
        break

    cv2.imshow("Normal Video", frame)

    key = cv2.waitKey(30) & 0xFF

    if key == ord('s'):
        cv2.waitKey(200)  # Slow motion
    elif key == ord('f'):
        cv2.waitKey(1)    # Fast motion
    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
