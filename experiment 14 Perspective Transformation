
import cv2
import numpy as np

img = cv2.imread(r"C:\Users\SAIL\OneDrive\Pictures\images (1).jpg")
h, w = img.shape[:2]

p1 = np.float32([[0, 0], [w, 0], [0, h], [w, h]])
p2 = np.float32([[50, 50], [w-50, 50], [0, h-50], [w, h]])

m = cv2.getPerspectiveTransform(p1, p2)
out = cv2.warpPerspective(img, m, (w, h))

cv2.imshow("Perspective Transformation", out)
cv2.waitKey(0)
cv2.destroyAllWindows()
