import cv2
import matplotlib.pyplot as plt

image_path = r"C:\Users\SAIL\OneDrive\Pictures\images (1).jpg"

img = cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

rot90 = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
rot180 = cv2.rotate(img, cv2.ROTATE_180)
rot270 = cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)

# Convert BGR to RGB
img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
rot90 = cv2.cvtColor(rot90, cv2.COLOR_BGR2RGB)
rot180 = cv2.cvtColor(rot180, cv2.COLOR_BGR2RGB)
rot270 = cv2.cvtColor(rot270, cv2.COLOR_BGR2RGB)

plt.subplot(2, 2, 1)
plt.imshow(img)
plt.title("Original Image")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(rot90)
plt.title("90 Degree Clockwise")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(rot180)
plt.title("180 Degree")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(rot270)
plt.title("270 Degree Clockwise")
plt.axis("off")

plt.tight_layout()
plt.show()
